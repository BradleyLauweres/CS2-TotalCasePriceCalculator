<Window x:Class="CS2TotalCasePriceCalc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CS2TotalCasePriceCalc"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Steam Case Inventory" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Editable DataGrid -->
        <DataGrid x:Name="CaseGrid" Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  HeadersVisibility="Column"
                  Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Case Name" Binding="{Binding CaseName}" Width="*"/>
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Content="Calculate Total Value"
                Grid.Row="2"
                Height="40"
                Click="Calculate_Click"
                Margin="0,10,0,10"/>

        <StackPanel Grid.Row="3">
            <ProgressBar x:Name="ProgressBar"
                         Height="20"
                         Minimum="0"
                         Maximum="100"
                         Visibility="Collapsed"
                         Margin="0,5,0,5"/>

            <TextBlock x:Name="ResultText"
                       FontSize="18"
                       FontWeight="Bold"
                       TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
